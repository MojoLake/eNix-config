#!/usr/bin/env bash
set -euo pipefail

key="${1:?usage: macos-key a|c|v|x|z|redo|f|r|s|t|w}"

app_id="$(niri msg --json focused-window | jq -r '.app_id // ""')"

case "$app_id:$key" in
    com.mitchellh.ghostty:a|com.mitchellh.ghostty:c|com.mitchellh.ghostty:v|com.mitchellh.ghostty:f|com.mitchellh.ghostty:t|com.mitchellh.ghostty:w)
        # Ghostty's clipboard, search, selection and tab shortcuts all use
        # Ctrl+Shift. Sending plain Ctrl+C must never replace terminal SIGINT.
        wtype -M ctrl -M shift "$key" -m shift -m ctrl
        ;;
    com.mitchellh.ghostty:z)
        # Zsh/readline undo. Ghostty has no terminal-wide cut, save or redo.
        wtype -M ctrl -M shift minus -m shift -m ctrl
        ;;
    com.mitchellh.ghostty:x|com.mitchellh.ghostty:s|com.mitchellh.ghostty:redo)
        ;;
    *:redo)
        wtype -M ctrl -M shift z -m shift -m ctrl
        ;;
    *:a|*:c|*:v|*:x|*:z|*:f|*:r|*:s|*:t|*:w)
        wtype -M ctrl "$key" -m ctrl
        ;;
    *)
        exit 2
        ;;
esac
