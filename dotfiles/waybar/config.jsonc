{
  "layer": "top",
  "position": "top",
  "height": 5,

  "modules-left": [
    "niri/workspaces"
  ],

  "modules-right": [
    "custom/recording",
    "custom/touchpad-disabled",
    "niri/language",
    "memory",
    "network",
    "battery",
    "clock"
  ],

  "custom/recording": {
    "exec": "printf '●\\n'",
    "exec-if": "pidfile=\"${XDG_RUNTIME_DIR:-/tmp}/gpu-screen-recorder-toggle.pid\"; test -r \"$pidfile\" && kill -0 \"$(cat \"$pidfile\")\" 2>/dev/null",
    "interval": 1,
    "tooltip": false
  },

  "custom/touchpad-disabled": {
    "exec": "printf 'TP×\\n'",
    "exec-if": "state_file=\"${XDG_STATE_HOME:-$HOME/.local/state}/niri/touchpad-state.kdl\"; test -r \"$state_file\" && grep -q '^// touchpad-disabled$' \"$state_file\"",
    "interval": 1,
    "tooltip": false
  },

  "niri/language": {
    "format": "{shortDescription}"
  },

  "memory": {
    "format": "M {percentage}%"
  },

  "network": {
    "format-wifi": "Wi-Fi",
    "format-disconnected": "No Wi-Fi",
    "on-click": "wifi-manager --toggle"
  },

  "battery": {
    "format": "🔋{capacity}%",
    "format-charging": "🔋{capacity}% +",
    "format-plugged": "🔋{capacity}% AC",
    "tooltip": true,
    "tooltip-format-charging": "Fully charged in approximately {time}",
    "format-time": "{H}h {M}m",
    "interval": 10
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "interval": 1
  }
}
