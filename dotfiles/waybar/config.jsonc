{
  "layer": "top",
  "position": "top",
  "height": 5,

  "modules-left": [
    "niri/workspaces"
  ],

  "modules-right": [
    "custom/recording",
    "niri/language",
    "memory",
    "network",
    "battery",
    "clock"
  ],

  "custom/recording": {
    "exec": "printf '●\\n'",
    "exec-if": "pidfile=\"${XDG_RUNTIME_DIR:-/tmp}/gpu-screen-recorder-toggle.pid\"; test -r \"$pidfile\" && kill -0 \"$(cat \"$pidfile\")\" 2>/dev/null",
    "interval": 1,
    "tooltip": false
  },

  "niri/language": {
    "format": "{shortDescription}"
  },

  "memory": {
    "format": "M {percentage}%"
  },

  "network": {
    "format-wifi": "Wi-Fi",
    "format-disconnected": "No Wi-Fi"
  },

  "battery": {
    "format": "🔋{capacity}%",
    "format-charging": "🔋{capacity}% +",
    "format-plugged": "🔋{capacity}% AC",
    "interval": 10
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "interval": 1
  }
}
