#!/usr/bin/env bash
set -euo pipefail

pidfile="${XDG_RUNTIME_DIR:-/tmp}/gpu-screen-recorder-toggle.pid"

if [[ -f "$pidfile" ]]; then
    pid="$(cat "$pidfile")"

    if kill -0 "$pid" 2>/dev/null; then
        kill -INT "$pid"
        rm -f "$pidfile"
        exit 0
    fi

    rm -f "$pidfile"
fi

mkdir -p "$HOME/Videos"

gpu-screen-recorder \
  -w eDP-1 \
  -c mp4 \
  -k auto \
  -ac opus \
  -f 60 \
  -cursor yes \
  -cr limited \
  -encoder gpu \
  -q very_high \
  -a device:default_output \
  -o "$HOME/Videos/Video_$(date +%Y-%m-%d_%H-%M-%S).mp4" &

echo "$!" > "$pidfile"
